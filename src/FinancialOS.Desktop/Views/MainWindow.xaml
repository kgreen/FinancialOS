<Window x:Class="FinancialOS.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FinancialOS.Desktop.Views"
        xmlns:vm="clr-namespace:FinancialOS.Desktop.ViewModels"
        Title="FinancialOS" Height="600" Width="900">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecordsViewModel}">
            <views:RecordsView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="140" Background="#F0F0F0">
            <Button Content="Accounts" Command="{Binding ShowAccountsCommand}" Margin="8,8,8,4" />
            <Button Content="Records"  Command="{Binding ShowRecordsCommand}"  Margin="8,4,8,4" />
        </StackPanel>
        <ContentControl Content="{Binding CurrentView}" Margin="8" />
    </DockPanel>
</Window>
