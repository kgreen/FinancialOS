@page
@model AccountsModel
@{
    ViewData["Title"] = "Accounts";
}

<h1 class="h3 mb-3">Accounts</h1>
<p class="text-muted">Inspect the account catalog exposed by the API.</p>

@if (!string.IsNullOrWhiteSpace(Model.ApiErrorMessage))
{
    <div class="alert alert-warning">@Model.ApiErrorMessage</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label">Page</label>
        <input asp-for="PageNumber" class="form-control" type="number" min="1" />
    </div>
    <div class="col-auto">
        <label class="form-label">Page size</label>
        <input asp-for="PageSize" class="form-control" type="number" min="1" max="50" />
    </div>
    <div class="col-auto align-self-end">
        <button class="btn btn-primary">Refresh</button>
    </div>
</form>

@if (Model.Accounts.Items.Count == 0)
{
    <div class="alert alert-secondary">No accounts were returned.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Accounts.Items)
                {
                    <tr>
                        <td>@account.Name</td>
                        <td>@account.Type</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
